// E-nursing platform data model.
// Postgres-backed so it can be deployed (e.g. to Vercel + Neon) as well as
// run locally — point DATABASE_URL at any Postgres instance, local or
// hosted, and this schema works unchanged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Subject {
  ANATOMY
  PHYSIOLOGY
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  MATCHING
  ANATOMICAL_LABELING
  CASE_BASED
  CLINICAL_REASONING
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  username                 String    @unique
  passwordHash             String
  fullName                 String
  locale                   String    @default("ar") // "ar" | "en"
  role                     String    @default("student")
  emailVerified            Boolean   @default(false)
  emailVerifyCode          String?
  emailVerifyCodeExpiresAt DateTime?
  emailVerifyAttempts      Int       @default(0)
  failedLoginCount         Int       @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  sessionVersion           Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  resetTokens        PasswordResetToken[]
  quizAttempts       QuizAttempt[]
  progress           ProgressRecord[]
  studyPlans         StudyPlan[]
  notifications      Notification[]
  sentNotifications  Notification[] @relation("SentNotifications")
  chatSessions       ChatSession[]
  loginEvents        LoginEvent[]
  auditLogs          AdminAuditLog[] @relation("AdminAuditLogs")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action     String // e.g. "user.create", "user.delete", "module.publish", "notification.broadcast"
  targetType String // "user" | "module" | "lesson" | "notification"
  targetId   String?
  detail     String? // short human-readable note, e.g. the affected user's email
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Course {
  id            String  @id @default(cuid())
  slug          String  @unique
  subject       Subject
  titleEn       String
  titleAr       String
  descriptionEn String
  descriptionAr String
  order         Int     @default(0)

  modules    Module[]
  studyPlans StudyPlan[]
}

model Module {
  id            String  @id @default(cuid())
  slug          String  @unique
  courseId      String
  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order         Int
  titleEn       String
  titleAr       String
  descriptionEn String
  descriptionAr String
  passThreshold Int     @default(70) // percent required to mark module complete
  isPublished   Boolean @default(true) // admin can temporarily hide a module from students

  lessons      Lesson[]
  questions    Question[]
  progress     ProgressRecord[]
  quizAttempts QuizAttempt[]
}

model Lesson {
  id             String  @id @default(cuid())
  slug           String  @unique
  moduleId       String
  module         Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order          Int
  titleEn        String
  titleAr        String
  objectivesEn   String // JSON-encoded string[]
  objectivesAr   String // JSON-encoded string[]
  contentEn      String // markdown
  contentAr      String // markdown
  termsJson      String // JSON-encoded {en, ar}[] medical terminology pairs
  summaryEn      String
  summaryAr      String
  referencesJson String // JSON-encoded string[] (citations, not claims of accreditation)
  videoUrl       String? // optional real YouTube link for this lesson's topic
  videoLabelEn   String? // one-line note telling the student what the video covers
  videoLabelAr   String?

  questions Question[]
}

model Question {
  id              String       @id @default(cuid())
  moduleId        String
  module          Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonId        String?
  lesson          Lesson?      @relation(fields: [lessonId], references: [id])
  type            QuestionType @default(MCQ)
  order           Int          @default(0)
  textEn          String
  textAr          String
  choicesJson     String // JSON-encoded {id, en, ar}[]
  correctChoiceId String
  explanationEn   String
  explanationAr   String

  studentAnswers StudentAnswer[]
}

model QuizAttempt {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId     String
  module       Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  scorePercent Int?
  passed       Boolean   @default(false)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  answers StudentAnswer[]

  @@index([userId, moduleId])
}

model StudentAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedChoiceId String
  isCorrect        Boolean

  @@index([attemptId])
}

model ProgressRecord {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId         String
  module           Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status           ProgressStatus @default(NOT_STARTED)
  bestScorePercent Int?
  completedAt      DateTime?
  updatedAt        DateTime       @updatedAt

  @@unique([userId, moduleId])
}

model StudyPlan {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  examDate   DateTime
  dailyHours Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions StudySession[]
}

model StudySession {
  id              String    @id @default(cuid())
  studyPlanId     String
  studyPlan       StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  scheduledFor    DateTime
  moduleId        String
  durationMinutes Int
  completed       Boolean   @default(false)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String // recipient
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId  String? // null = system-generated (security alert, automated content update)
  sender    User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  titleEn   String
  titleAr   String
  bodyEn    String
  bodyAr    String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(cuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role          ChatRole
  content       String
  createdAt     DateTime    @default(now())
}
