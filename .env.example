DATABASE_URL="postgresql://user:password@localhost:5432/enursing"

# Session signing secret (HS256). Generate a strong random value for production.
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_SECRET"

# --- Not yet configured. See README "External services" section. ---
# AI provider key for the "Ask Novia" tutor (e.g. an Anthropic API key).
# Leave empty to keep Ask Novia in its safe "not configured" state.
AI_PROVIDER_API_KEY=""

# Clerk (optional future replacement for the local auth system).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Resend (https://resend.com) — powers real password-reset and email-
# verification emails. Leave empty to keep the dev-mode fallback (the link
# is logged to the console and shown in-app instead of emailed).
RESEND_API_KEY=""
# Must be a verified sender on your Resend account once you have a custom
# domain; the default below is Resend's shared testing address.
EMAIL_FROM="E-nursing <onboarding@resend.dev>"
