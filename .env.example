DATABASE_URL="postgresql://user:password@localhost:5432/enursing"

# Session signing secret (HS256). Generate a strong random value for production.
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_SECRET"

# --- Not yet configured. See README "External services" section. ---
# AI provider key for the "Ask Novia" tutor (e.g. an Anthropic API key).
# Leave empty to keep Ask Novia in its safe "not configured" state.
AI_PROVIDER_API_KEY=""

# Tidio ("Ask Novia" chatbot — https://www.tidio.com). Get your Public Key
# from the Tidio dashboard under Settings > Developer > "Tidio API keys",
# or from the install snippet under Channels > Live Chat > Install — it's
# the code right before ".js" in "//code.tidio.co/<PUBLIC_KEY>.js".
# Leave empty to keep showing the site's own built-in Novia widget
# (components/novia/novia-widget.tsx) instead. As soon as this is set, the
# site switches to loading the Tidio widget (components/novia/tidio-embed.tsx).
NEXT_PUBLIC_TIDIO_PUBLIC_KEY=""

# Clerk (optional future replacement for the local auth system).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Gmail SMTP — powers real password-reset and email-verification emails.
# Leave empty to keep the dev-mode fallback (the link is logged to the
# console and shown in-app instead of emailed).
# GMAIL_USER must have 2-Step Verification enabled; GMAIL_APP_PASSWORD is a
# 16-character App Password generated at myaccount.google.com (Security >
# App passwords) — never your actual Google account password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM="E-nursing <you@gmail.com>"

# Unsplash (https://unsplash.com/developers) — powers the "Search Image"
# picker in the admin lesson editor. Free account, no card required.
# Leave empty to keep that picker in its "not configured" state.
UNSPLASH_ACCESS_KEY=""

# Optional: your production domain (e.g. "https://e-nursing.vercel.app" or a
# custom domain). Used only to build the logo image URL in emails. On Vercel
# this is not needed — it's detected automatically from VERCEL_URL.
NEXT_PUBLIC_SITE_URL=""

# Protects /api/cron/study-reminders (the daily/weekly study-plan email
# reminder job defined in vercel.json). Generate any random string and set
# the SAME value here and in Vercel's Environment Variables — Vercel then
# automatically sends it as a Bearer token when it triggers the cron job,
# so nobody else can call this endpoint and spam students with emails.
# The route refuses to run at all while this is empty.
#
# IMPORTANT — Vercel's Hobby (free) plan limits Cron Jobs to at most once a
# day; the hourly schedule in vercel.json requires a paid Pro plan to fire
# every hour and actually match each student's chosen reminder time. On
# Hobby, only whichever single run Vercel does allow will fire, so most
# students' chosen times will be missed until you upgrade.
CRON_SECRET=""
