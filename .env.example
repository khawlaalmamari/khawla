DATABASE_URL="postgresql://user:password@localhost:5432/enursing"

# Session signing secret (HS256). Generate a strong random value for production.
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_SECRET"

# --- Not yet configured. See README "External services" section. ---
# AI provider key for the "Ask Novia" tutor (e.g. an Anthropic API key).
# Leave empty to keep Ask Novia in its safe "not configured" state.
AI_PROVIDER_API_KEY=""

# Clerk (optional future replacement for the local auth system).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Gmail SMTP — powers real password-reset and email-verification emails.
# Leave empty to keep the dev-mode fallback (the link is logged to the
# console and shown in-app instead of emailed).
# GMAIL_USER must have 2-Step Verification enabled; GMAIL_APP_PASSWORD is a
# 16-character App Password generated at myaccount.google.com (Security >
# App passwords) — never your actual Google account password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM="E-nursing <you@gmail.com>"

# Unsplash (https://unsplash.com/developers) — powers the "Search Image"
# picker in the admin lesson editor. Free account, no card required.
# Leave empty to keep that picker in its "not configured" state.
UNSPLASH_ACCESS_KEY=""

# Optional: your production domain (e.g. "https://e-nursing.vercel.app" or a
# custom domain). Used only to build the logo image URL in emails. On Vercel
# this is not needed — it's detected automatically from VERCEL_URL.
NEXT_PUBLIC_SITE_URL=""
