DATABASE_URL="postgresql://user:password@localhost:5432/enursing"

# Session signing secret (HS256). Generate a strong random value for production.
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_SECRET"

# --- Not yet configured. See README "External services" section. ---
# AI provider key for the "Ask Novia" tutor (e.g. an Anthropic API key).
# Leave empty to keep Ask Novia in its safe "not configured" state.
AI_PROVIDER_API_KEY=""

# Clerk (optional future replacement for the local auth system).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# SendGrid (https://sendgrid.com) — powers real password-reset and email-
# verification emails via Single Sender Verification (no domain required).
# Leave empty to keep the dev-mode fallback (the link is logged to the
# console and shown in-app instead of emailed).
SENDGRID_API_KEY=""
# Must be the exact email address you verified as a Single Sender in
# SendGrid; otherwise SendGrid rejects the send.
EMAIL_FROM="E-nursing <you@example.com>"
